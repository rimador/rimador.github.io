<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mapa del lloc del Rimador.cat — totes les pàgines que es poden indexar.

  COMPTE: AQUEST FITXER NO ÉS EL QUE ES PUBLICA. El pas «Regenerar el
  sitemap.xml» de .github/workflows/deploy.yml el reescriu sencer a cada
  desplegament a partir del <link rel="canonical"> de cada pàgina. El que
  s'editi aquí no arriba mai a rimador.cat, i aquesta llista pot anar
  endarrerida. La de debò és la de https://rimador.cat/sitemap.xml, i el
  registre d'aquell pas del deploy també n'imprimeix les adreces.

  Per tant, una pàgina nova hi entra sola sempre que dugui canonical i no dugui
  noindex. A mà només cal afegir-la al menú (js/menu.js), si hi ha d'anar.
  En queden fora les noindex: el 404.html, que no és una pàgina del lloc sinó
  la resposta a una adreça que no existeix, i les eines internes de
  diccionaris/python/ i joc/eines/. Les de html/ tampoc no hi són: aquella
  carpeta és al .gitignore i no arriba mai a publicar-se.

  No hi ha <lastmod> enlloc, i és volgut (el generador del deploy tampoc no
  n'escriu). El pas del deploy que estampa el ?v=
  reescriu el ?v= de TOTS els HTML cada vegada que es toca el css o el js, o
  sigui que la data del fitxer publicat diria que totes les pàgines han
  canviat quan en realitat no n'ha canviat ni una lletra del contingut. Google només fa cas del
  lastmod si se'l pot creure sempre; val més no posar-n'hi cap que no pas
  posar-n'hi un que menteix cada desplegament.

  Tampoc no hi ha <changefreq> ni <priority>: Google els ignora del tot.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- El cercador de rimes -->
  <url>
    <loc>https://rimador.cat/</loc>
  </url>

  <!-- El joc -->
  <url>
    <loc>https://rimador.cat/joc/</loc>
  </url>

  <!-- El generador de paraules per a freestylers. Encara no és al menú
       (js/menu.js), però sí que s'ha de poder trobar. -->
  <url>
    <loc>https://rimador.cat/freestyle_beta.html</loc>
  </url>

  <!-- Les llistes -->
  <url>
    <loc>https://rimador.cat/llistes/llista_heptasilabs.html</loc>
  </url>
  <url>
    <loc>https://rimador.cat/llistes/llista_mots_de7.html</loc>
  </url>
  <url>
    <loc>https://rimador.cat/llistes/llista_naufragues.html</loc>
  </url>

  <!-- La resta -->
  <url>
    <loc>https://rimador.cat/dades.html</loc>
  </url>
  <url>
    <loc>https://rimador.cat/nosaltres.html</loc>
  </url>
  <url>
    <loc>https://rimador.cat/dialectes.html</loc>
  </url>
  <url>
    <loc>https://rimador.cat/historial_canvis.html</loc>
  </url>
  <url>
    <loc>https://rimador.cat/error.html</loc>
  </url>

</urlset>
